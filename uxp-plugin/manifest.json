{
  "id": "com.antigravity.airetouch",
  "name": "AI Retouch - Blemish Remover",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "blemishRemovalPanel",
      "label": {
        "default": "AI Blemish Remover"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "maximumSize": {
        "width": 2560,
        "height": 2560
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "plugin",
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest"]
    }
  ]
}
